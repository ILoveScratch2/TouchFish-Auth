# TouchFish Auth —— 部署时填写，仓库里不放任何生产地址默认值。
# 全部变量缺失时服务启动失败，避免"以为配了其实没配"。

# 必填：对外可访问的基址，决定 issuer 与 JWKS 地址
AUTH_BASE_URL=http://127.0.0.1:8000

# 选填：留空则等于 AUTH_BASE_URL。TFV5 的 jwt_external_issuers[].iss 必须与此完全一致
AUTH_ISSUER=

# 必填：用于加密 TFV5 refresh token 的 32 字节密钥（base64）
# 生成：python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
AUTH_MASTER_KEY=

# 存储
AUTH_DB_PATH=./data/auth.db
AUTH_KEY_DIR=./keys

# 注册开关：follow_tfv5 | force_on | force_off
AUTH_ALLOW_REGISTRATION=follow_tfv5

# 默认 TFV5 实例（客户端未传 target 时使用）
AUTH_DEFAULT_INSTANCE_URL=http://127.0.0.1:7001
AUTH_DEFAULT_INSTANCE_ID=main

# TFV5 是否允许明文 HTTP（仅本地联调）
AUTH_TFV5_ALLOW_INSECURE_HTTP=1

# 有效期（秒）
AUTH_SESSION_TTL=604800
AUTH_TOKEN_TTL=300
AUTH_TICKET_TTL=60

# Cookie 是否带 Secure。本地 http 调试必须为 0
AUTH_COOKIE_SECURE=0

# 站点名（首次启动写入库，之后以管理端「站点配置」为准）
AUTH_SITE_NAME=TouchFish Auth

# 本地联调：邮件不外发，写入内存收件箱 /api/dev/outbox。生产必须为 0
AUTH_DEV_MAIL=0

# 反代场景：默认不信任 X-Forwarded-For（客户端可伪造）。
# 优先用 uvicorn 的 --proxy-headers --forwarded-allow-ips=<代理地址>；
# 只有在无法使用该机制时才置 1，让本服务自己解析 XFF。
AUTH_TRUST_PROXY=0

# 额外允许的浏览器来源（逗号分隔的完整 origin，如 https://auth.example.com）。
# 默认只允许与请求 Host 同源；当前端独立部署在别的域名时才需要在这里列出。
AUTH_ALLOWED_ORIGINS=
